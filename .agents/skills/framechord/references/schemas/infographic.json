  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audience": {
      "type": "string"
    },
    "canvas": {
      "type": "string"
    },
    "key_message": {
      "type": "string"
    },
    "layout": {
      "type": "string"
    },
    "references": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InfoReference"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/InfoSection"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "visual_brief": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "title",
    "audience",
    "key_message",
    "canvas",
    "layout",
    "sections",
    "visual_brief"
  ],
  "title": "Infographic",
  "type": "object"
}